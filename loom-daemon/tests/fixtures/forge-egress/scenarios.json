  "description": "Forge-egress validator fixtures shared with 2AMLogic/2am (#9984). Each row is a static validator input; `expected` is what Loom's Rust validator must produce, `upstream` is what 2am's scripts/lib/github_egress.py produces for the same inputs (computed by running it). Rows s00-s17 translate the 17 live-gh scenarios of 2am scripts/tests/test-github-egress-fixtures.py into the configuration each one exercises; u-* rows mirror scripts/tests/test-github-egress.py. Every code in expected but not in upstream must be a Loom-only code (forge_egress::checks::LOOM_ONLY_CODES) or carry a `loom_only_surface` note. No real credentials: profiles are rendered from the shape names below with a placeholder token.",
  "upstream_validator": {
    "repo": "2AMLogic/2am",
    "path": "scripts/lib/github_egress.py",
    "commit": "8c947aea0026cdb7cda97ea20eea706c4daaf058",
    "note": "`upstream` re-derived by running this file over every row: 0 mismatches. Every row except u-adapter-block-accepted (the P2 `adapter` schema addition) also matches the P0 commit e61116be. policy.schema.json is vendored byte-identical from this commit."
  },
  "base_policies": {
    "example": "policy.example.json (2am infra/github-proxy, verbatim)",
    "fixture": "policy.fixture.json"
  },
  "profile_shapes": {
    "routed": "the logical-host entry carries api_host = the policy's expected api_host",
