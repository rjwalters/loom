{
  "name": "@loom/mcp",
  "version": "0.19.23",
  "description": "Unified MCP server for Loom - combines logs, UI, and terminal tools",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mcp-loom": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && rm -rf dist && node esbuild.config.js",
    "build:bundle": "rm -rf dist && node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:daemon-timeout": "node scripts/verify-daemon-timeout.mjs",
    "watch": "tsc --watch --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
