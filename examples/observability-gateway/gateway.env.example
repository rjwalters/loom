# gateway.env.example — copy the values (never this file) into the private
# gateway.env next to the deployed compose.yaml. That file stays outside every
# Git repository (see ~/.loom/observability/cloud/machine/README.md); this
# example only documents WHICH keys deploy.sh and compose require.
#
# Host telemetry identity (must match the host_id the fleet knows, e.g. from
# hosts.yml / dashboard telemetry):
LOOM_HOST_ID=hostname-or-pinned-telemetry-id

# Absolute host paths to the runtime session stores tailed by the filelog
# receivers (issue rjwalters/loom#8664):
LOOM_CODEX_SESSIONS_DIR=/home/you/.codex/sessions
LOOM_PI_SESSIONS_DIR=/home/you/.pi/agent/sessions
LOOM_CLAUDE_PROJECTS_DIR=/home/you/.claude/projects

# Collector writable state (file_storage for the durable sending queues):
LOOM_COLLECTOR_UID=501
LOOM_COLLECTOR_GID=20
LOOM_COLLECTOR_STATE_DIR=/home/you/.local/state/loom/observability/cloud-collector

# Secret file paths (contents are mounted as container secrets; the files
# themselves stay private):
LOOM_COLLECTOR_INGEST_KEY_FILE=/home/you/.loom/observability/cloud/loom-ingest.key
LOOM_SIGNOZ_INGEST_KEY_FILE=/home/you/.loom/observability/cloud/signoz-ingest.key
LOOM_CLICKHOUSE_PASSWORD_FILE=/home/you/.loom/observability/cloud/clickhouse-loom-ingest-password.key

# Upstream sink endpoints (the collector config only references these via
# ${env:}; no endpoint or credential is ever committed):
LOOM_SIGNOZ_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
LOOM_CLICKHOUSE_ENDPOINT=https://your-clickhouse.example:8443
LOOM_CLICKHOUSE_USERNAME=loom_ingest
