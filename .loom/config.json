{
  "version": "2",
  "buildGate": {
    "enabled": false,
    "command": "bash .loom/scripts/build-gate.sh",
    "realChangeGlobs": [
      "*.rs",
      "*.toml",
      "Cargo.lock",
      "*.py",
      "*.sh"
    ],
    "timeoutSeconds": 1200,
    "loadThreshold": 0.9,
    "maxDeferSeconds": 1800,
    "preflightPathScopes": [
      {
        "env": "LOOM_BUILD_GATE_INSTALLER_SUITE",
        "suite": "scripts/test-installer.sh",
        "runWhenChanged": [
          "install.sh",
          "scripts/install-loom.sh",
          "scripts/uninstall-loom.sh",
          "scripts/install/*",
          "scripts/test-installer.sh",
          "scripts/version.sh",
          "scripts/daemon-build.sh",
          "scripts/cargo-target-dir.sh",
          "scripts/loom",
          "defaults/*",
          ".github/labels.yml",
          "loom-daemon/src/init/*",
          "loom-daemon/src/worker_spawn/*",
          "loom-daemon/src/runtime_admission*",
          "loom-daemon/src/preflight.rs",
          "loom-daemon/src/main_health_gate.rs",
          ".claude/settings.json",
          ".loom/config.json"
        ]
      }
    ]
  },
  "guards": {
    "sqlDdl": false,
    "cloudCli": false,
    "forceScope": "protected",
    "decisionLog": true
  },
  "branchProtection": {
    "_comment": "Read by scripts/install/setup-branch-protection.sh (#8103). These are the check-run names of every ci.yml job that ALWAYS runs and can actually fail — no job behind `needs: changes` (a skipped path-filtered job that never reports would block merges), and not the advisory drift check. `CI Result` (#10444) is the always-run aggregate that fails when Detect Changes is cancelled; it is listed here but must NOT be applied to the live ruleset until it has reported on main (a required context that never reports blocks every merge) — rerun setup-branch-protection.sh as an operator step after that. Names are the job's `name:` with matrix values substituted, verified against live check-runs on main.",
    "requiredStatusChecks": [
      "Structural Checks",
      "Shell Syntax (macos-latest)",
      "Daemon Checks",
      "CI Result"
    ],
    "strictRequiredStatusChecks": false
  },
  "terminals": [
    {
      "id": "terminal-1",
      "name": "Judge",
      "role": "claude-code-worker",
      "roleConfig": {
        "workerType": "claude",
        "roleFile": "judge.md",
        "targetInterval": 180000,
        "intervalPrompt": "Review pull requests with loom:review-requested label"
      },
      "theme": "ocean"
    },
    {
      "id": "terminal-2",
      "name": "Curator",
      "role": "claude-code-worker",
      "roleConfig": {
        "workerType": "claude",
        "roleFile": "curator.md",
        "targetInterval": 180000,
        "intervalPrompt": "Find unlabeled issues and enhance with implementation details"
      },
      "theme": "forest"
    },
    {
      "id": "terminal-3",
      "name": "Hermit",
      "role": "claude-code-worker",
      "roleConfig": {
        "workerType": "claude",
        "roleFile": "hermit.md",
        "targetInterval": 300000,
        "intervalPrompt": "Identify code simplification and removal opportunities"
      },
      "theme": "sunset"
    },
    {
      "id": "terminal-4",
      "name": "Champion",
      "role": "claude-code-worker",
      "roleConfig": {
        "workerType": "claude",
        "roleFile": "champion.md",
        "targetInterval": 600000,
        "intervalPrompt": "Check for PRs ready to auto-merge with loom:pr label"
      },
      "theme": "midnight"
    }
  ]
}
